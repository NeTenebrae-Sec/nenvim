{
	"react: function component": {
		"prefix": "rfc",
		"body": [
			"function ${1:Component}() {",
			"\treturn (",
			"\t\t<div>$0</div>",
			"\t);",
			"}",
			"",
			"export default ${1:Component};"
		],
		"description": "Componente funcional con export default"
	},
	"react: arrow component": {
		"prefix": "rac",
		"body": [
			"const ${1:Component} = () => {",
			"\treturn (",
			"\t\t<div>$0</div>",
			"\t);",
			"};",
			"",
			"export default ${1:Component};"
		],
		"description": "Componente arrow con export default"
	},
