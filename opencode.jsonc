// Config de OpenCode para este proyecto (nenvim).
// Spec: specs/tasks/000-mcp-setup.md
{
  "$schema": "https://opencode.ai/config.json",
  // AGENTS.md vive en las specs (repo neteumbra/specs) — no en la raíz, que
  // es solo código. Sin esta entrada OpenCode no lo descubre y las reglas de
  // nvim-mcp dejan de aplicarse (silenciosamente, si falta el symlink).
  "instructions": ["specs/AGENTS.md"],
  "mcp": {
    "servers": {
      // --offline: uv usa su caché local (nvim-mcp 1.1.1) — el server MCP
      // no debe caerse con un corte de red/DNS (incidente 2026-10-17).
      "nvim-mcp": {
        "type": "local",
        "command": ["uvx", "--offline", "nvim-mcp"],
        "environment": {
          "NVIM_ADDRESS": "{env:XDG_RUNTIME_DIR}/nvim-mcp.sock"
        }
      }
    }
  }
}
